<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RfScout\RfScout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Hardware tests P/Invoke hackrf.dll, so the native folder has to land in the test output
      too. A ProjectReference does not carry the app project's None items, hence this copy.
    -->
    <None Include="..\..\native\x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded IQ snippets (complex s8 + SigMF header) used as decoder fixtures. -->
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\RfScout\Core\Spectrum\bandplan.json" Link="bandplan.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The app is OutputType=WinExe and so carries the Windows Desktop framework reference. The
      test project needs the same one: without it the test host resolves WPF from its own TPA
      list, PresentationCore loads twice, and the first WPF type load fails with
      "DefaultDispatcher was defaulted twice" (dotnet/wpf#5359). Tests that never touch the UI
      pay for it in module load time only.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

</Project>
