<Window x:Class="RfScout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RfScout.ViewModels"
        Title="{Binding Title}" Width="640" Height="400" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterScreen">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" Text="{Binding Title}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Grid.Row="1" Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap"
               Text="{Binding StatusText}" AutomationProperties.Name="Status"
               AutomationProperties.LiveSetting="Polite" />
  </Grid>
</Window>
