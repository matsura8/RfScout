<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- x64 only: hackrf.dll in native\x64 is x64, and the DSP paths assume it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RfScout</RootNamespace>
    <AssemblyName>RfScout</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RfScout.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Native dependencies built by native\build-libhackrf.ps1 and recorded in native\README.md.
      They must sit next to RfScout.exe: hackrf.dll imports libusb-1.0.dll and pthreadVC3.dll.
    -->
    <None Include="..\..\native\x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
