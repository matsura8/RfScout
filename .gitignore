# Build output (out\artifacts, test results)
/out/
# .NET
bin/
obj/
*.user
# IDEs
.vs/
.idea/
*.suo
# Crash dumps / secrets never belong in git
*.dmp
*.pfx
*.p12
*.snk
.env

# native: cloned hackrf source + vcpkg tree, rebuilt by native\build-libhackrf.ps1
# (the built DLLs in native\x64 are committed on purpose)
/native/src/

# dev audit: gitleaks exclusions for the vendored native source tree (see .gitleaksignore,
# which is gitignored because its fingerprints point at paths under native/src).
.gitleaksignore
